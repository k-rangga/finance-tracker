{
  "name": "personal-spending-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && cp dist/index.html apps-script/Index.html",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "push": "npm test && npm run build && cd apps-script && clasp --user personal push -f",
    "deploy": "npm run push && cd apps-script && clasp --user personal deploy -i AKfycbz5wlPdIQnckBezbe81csIb84QH_uc-Rl5yZS9fYUnUr38TFqOXhhrGujXo2axUFZcs -d \"$(git log -1 --format=%s)\"",
    "test": "node apps-script/test/parse.test.mjs && npm run test:server && npm run test:plans",
    "test:plans": "esbuild src/lib/installments.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/installments.test.mjs --log-level=warning && node node_modules/.cache/installments.test.mjs",
    "build:web": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "test:server": "esbuild server/engine.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/engine.test.mjs --log-level=warning && node node_modules/.cache/engine.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
