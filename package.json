{
  "name": "personal-spending-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && cp dist/index.html apps-script/Index.html",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "push": "npm test && npm run build && cd apps-script && clasp --user personal push -f",
    "deploy": "npm run push && cd apps-script && clasp --user personal deploy -i AKfycbz5wlPdIQnckBezbe81csIb84QH_uc-Rl5yZS9fYUnUr38TFqOXhhrGujXo2axUFZcs -d \"$(git log -1 --format=%s)\"",
    "test": "node apps-script/test/parse.test.mjs && npm run test:server && npm run test:plans && npm run test:bills && npm run test:cycle && npm run test:proj && npm run test:pace && npm run test:boot && npm run test:cal && npm run test:journal && npm run test:wealth",
    "test:wealth": "esbuild src/lib/wealth.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/wealth.test.mjs --log-level=warning && node node_modules/.cache/wealth.test.mjs",
    "test:plans": "esbuild src/lib/installments.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/installments.test.mjs --log-level=warning && node node_modules/.cache/installments.test.mjs",
    "test:bills": "esbuild src/lib/fixedBills.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/fixedBills.test.mjs --log-level=warning && node node_modules/.cache/fixedBills.test.mjs",
    "test:cycle": "esbuild src/lib/cyclePlans.test.ts --bundle --platform=node --format=esm --packages=external --define:import.meta.env='{}' --outfile=node_modules/.cache/cyclePlans.test.mjs --log-level=warning && node node_modules/.cache/cyclePlans.test.mjs",
    "test:proj": "esbuild src/lib/projection.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/projection.test.mjs --log-level=warning && node node_modules/.cache/projection.test.mjs",
    "test:boot": "esbuild src/lib/bootHint.test.ts --bundle --platform=node --format=esm --packages=external --define:import.meta.env='{}' --outfile=node_modules/.cache/bootHint.test.mjs --log-level=warning && node node_modules/.cache/bootHint.test.mjs",
    "test:cal": "esbuild src/lib/calendar.test.ts --bundle --platform=node --format=esm --packages=external --define:import.meta.env='{}' --outfile=node_modules/.cache/calendar.test.mjs --log-level=warning && node node_modules/.cache/calendar.test.mjs",
    "build:web": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "test:server": "esbuild server/engine.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/engine.test.mjs --log-level=warning && node node_modules/.cache/engine.test.mjs",
    "test:pace": "esbuild src/lib/pace.test.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/pace.test.mjs --log-level=warning && node node_modules/.cache/pace.test.mjs",
    "test:journal": "esbuild src/lib/journal.test.ts --bundle --platform=node --format=esm --packages=external --define:import.meta.env='{}' --outfile=node_modules/.cache/journal.test.mjs --log-level=warning && node node_modules/.cache/journal.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  }
}
